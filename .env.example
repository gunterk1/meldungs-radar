# Provider-agnostisch: derselbe Code gegen gehostet oder selbst betrieben.
#
# Gehostet (für beide mitgelieferten Profile vertretbar — die Quellen sind
# öffentliche Behördenmeldungen, es fließen keine personenbezogenen Daten):
RADAR_BASIS_URL=https://api.openai.com/v1
RADAR_MODELL=gpt-4o-mini
RADAR_API_KEY=

# Welches Profil der Zeitplan fährt. Ohne Angabe: bsi.
RADAR_PROFIL=bsi

# Selbst betrieben (Ollama) — nur diese drei Zeilen tauschen, kein Codeumbau.
# Verpflichtend, sobald ein Profil Kundendaten berührt.
# RADAR_BASIS_URL=http://ollama:11434/v1
# RADAR_MODELL=llama3.1:8b
# RADAR_API_KEY=

# STEUERRADAR_* wird als Altname weiter gelesen, damit eine bestehende
# Konfiguration nicht stillschweigend ignoriert wird.
